# ---- Copy to .env and fill in ----

# Envisalink module IP on your LAN and TPI port (default 4025).
EVL_HOST=192.168.1.100
EVL_PORT=4025
# The Envisalink TPI password (same as its local web page login).
# Envisalink 4 supports up to 10 characters.
EVL_PASSWORD=

# Required. Encrypts the stored panel user code + EVL password and signs login sessions.
# Generate a strong value:  openssl rand -hex 32
APP_SECRET=

# Host port the web UI is published on (behind your HTTPS reverse proxy).
WEB_PORT=8080

# Optional extra CORS origins (comma separated). Normally leave blank.
CORS_ORIGINS=
